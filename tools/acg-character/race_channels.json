{
 "_doc": "How the ACG UMA race provides each DNA channel of NpcMeshes.UmaChannels (ADR-0014, ADR-0015, docs/design/npc-uma-looks.md). kind: bone = UMA DNA bone scale/position/rotation, set up in Unity, nothing baked; target = MakeHuman target pair baked as shape keys '<name>+' / '<name>-' one net weight step (incr minus decr) away from the base spec, capped at ±1 (race.py reports the step that fitted) (both sides when it lists l- and r-); param = spec value (or acg_face's default when the spec has none) nudged by step and baked through the full ACG build; slot = carried by a wardrobe slot's own blendshape; shader = material parameter; sculpt = no MakeHuman target or spec value isolates it yet, a custom shape has to be made. per: channel change that one full key stands for; null = not calibrated yet (calibrated against the procedural figure at gate 3).",
 "version": 1,
 "channels": {
  "body.height": {"kind": "bone", "bones": ["Root"], "note": "uniform scale"},
  "body.headRatio": {"kind": "bone", "bones": ["head"], "note": "uniform head scale; neck length follows"},
  "body.legShare": {"kind": "bone", "bones": ["thigh_l", "thigh_r", "calf_l", "calf_r"], "note": "length along the bone"},
  "body.shoulder": {"kind": "bone", "bones": ["clavicle_l", "clavicle_r"], "note": "outward position"},
  "body.trunkWidth": {"kind": "bone", "bones": ["spine_01", "spine_02", "spine_03"], "note": "side scale"},
  "body.trunkDepth": {"kind": "target", "pos": ["torso-scale-depth-incr"], "neg": ["torso-scale-depth-decr"], "per": null},
  "body.hipWidth": {"kind": "bone", "bones": ["thigh_l", "thigh_r"], "note": "outward position"},
  "body.belly": {"kind": "target", "pos": ["stomach-pregnant-incr"], "neg": ["stomach-pregnant-decr"], "per": null},
  "body.bulk": {"kind": "bone", "bones": ["upperarm_l", "upperarm_r", "lowerarm_l", "lowerarm_r", "thigh_l", "thigh_r", "calf_l", "calf_r", "spine_01", "spine_02", "spine_03"], "note": "radial scale"},
  "body.neck": {"kind": "target", "pos": ["measure-neck-circ-incr"], "neg": ["measure-neck-circ-decr"], "per": null},
  "body.armLength": {"kind": "bone", "bones": ["upperarm_l", "upperarm_r", "lowerarm_l", "lowerarm_r"], "note": "length along the bone"},
  "body.armRadius": {"kind": "bone", "bones": ["upperarm_l", "upperarm_r", "lowerarm_l", "lowerarm_r"], "note": "radial scale"},
  "body.legRadius": {"kind": "bone", "bones": ["thigh_l", "thigh_r", "calf_l", "calf_r"], "note": "radial scale"},
  "limb.thigh": {"kind": "target", "pos": ["measure-thigh-circ-incr"], "neg": ["measure-thigh-circ-decr"], "per": null},
  "limb.thighMid": {"kind": "target", "pos": ["l-upperleg-fat-incr", "r-upperleg-fat-incr"], "neg": ["l-upperleg-fat-decr", "r-upperleg-fat-decr"], "per": null},
  "limb.knee": {"kind": "target", "pos": ["measure-knee-circ-incr"], "neg": ["measure-knee-circ-decr"], "per": null},
  "limb.calf": {"kind": "target", "pos": ["measure-calf-circ-incr"], "neg": ["measure-calf-circ-decr"], "per": null},
  "limb.ankle": {"kind": "sculpt", "note": "MakeHuman scales the whole lower leg; the ankle alone needs its own shape"},
  "limb.upperArm": {"kind": "target", "pos": ["measure-upperarm-circ-incr"], "neg": ["measure-upperarm-circ-decr"], "per": null},
  "limb.upperArmMid": {"kind": "target", "pos": ["l-upperarm-fat-incr", "r-upperarm-fat-incr"], "neg": ["l-upperarm-fat-decr", "r-upperarm-fat-decr"], "per": null},
  "limb.elbow": {"kind": "sculpt", "note": "no elbow circumference target"},
  "limb.forearm": {"kind": "target", "pos": ["l-lowerarm-muscle-incr", "r-lowerarm-muscle-incr"], "neg": ["l-lowerarm-muscle-decr", "r-lowerarm-muscle-decr"], "per": null},
  "limb.wrist": {"kind": "sculpt", "note": "no wrist circumference target"},
  "spine.lean": {"kind": "bone", "bones": ["spine_01", "spine_02", "spine_03"], "note": "forward rotation, shared out along the spine"},
  "body.muscle": {"kind": "param", "key": "macro.muscle", "step": 0.25, "per": null},
  "body.fat": {"kind": "param", "key": "macro.weight", "step": 0.25, "per": null},
  "body.grown": {"kind": "bone", "bones": ["Root", "head"], "note": "child proportions: overall scale with a larger head; face fields carry the rest"},

  "face.skullWidth": {"kind": "target", "pos": ["head-scale-horiz-incr"], "neg": ["head-scale-horiz-decr"], "per": null},
  "face.skullHeight": {"kind": "target", "pos": ["head-scale-vert-incr"], "neg": ["head-scale-vert-decr"], "per": null},
  "face.skullDepth": {"kind": "target", "pos": ["head-scale-depth-incr"], "neg": ["head-scale-depth-decr"], "per": null},
  "face.cheekboneWidth": {"kind": "target", "pos": ["l-cheek-bones-incr", "r-cheek-bones-incr"], "neg": ["l-cheek-bones-decr", "r-cheek-bones-decr"], "per": null},
  "face.cheekFat": {"kind": "target", "pos": ["l-cheek-volume-incr", "r-cheek-volume-incr"], "neg": ["l-cheek-volume-decr", "r-cheek-volume-decr"], "per": null},
  "face.length": {"kind": "target", "pos": ["chin-jaw-drop-incr"], "neg": ["chin-jaw-drop-decr"], "per": null},
  "face.jawWidth": {"kind": "target", "pos": ["chin-bones-incr"], "neg": ["chin-bones-decr"], "per": null},
  "face.jawAngle": {"kind": "target", "pos": ["head-square"], "neg": ["head-round"], "per": null},
  "face.chinWidth": {"kind": "target", "pos": ["chin-width-incr"], "neg": ["chin-width-decr"], "per": null},
  "face.chinJut": {"kind": "target", "pos": ["chin-prognathism-incr"], "neg": ["chin-prognathism-decr"], "per": null},
  "face.chinHeight": {"kind": "target", "pos": ["chin-height-incr"], "neg": ["chin-height-decr"], "per": null},
  "face.jowl": {"kind": "target", "pos": ["neck-double-incr"], "neg": ["neck-double-decr"], "per": null},
  "mouth.width": {"kind": "param", "key": "face.mouth_half", "default": 0.011, "step": 0.002, "per": null},
  "mouth.upperLip": {"kind": "target", "pos": ["mouth-upperlip-volume-incr"], "neg": ["mouth-upperlip-volume-decr"], "per": null},
  "mouth.lowerLip": {"kind": "target", "pos": ["mouth-lowerlip-volume-incr"], "neg": ["mouth-lowerlip-volume-decr"], "per": null},
  "mouth.height": {"kind": "param", "key": "face.mouth_dz", "default": 0.0, "step": 0.003, "per": null},
  "mouth.corners": {"kind": "param", "key": "face.mouth_smile", "default": 0.0012, "step": 0.002, "per": null},
  "nose.length": {"kind": "target", "pos": ["nose-scale-vert-incr"], "neg": ["nose-scale-vert-decr"], "per": null},
  "nose.width": {"kind": "target", "pos": ["nose-scale-horiz-incr"], "neg": ["nose-scale-horiz-decr"], "per": null},
  "nose.bridge": {"kind": "target", "pos": ["nose-scale-depth-incr"], "neg": ["nose-scale-depth-decr"], "per": null},
  "nose.tip": {"kind": "target", "pos": ["nose-point-up"], "neg": ["nose-point-down"], "per": null},
  "eye.size": {"kind": "param", "key": "face.eye_w", "default": 1.15, "step": 0.15, "per": null},
  "eye.spread": {"kind": "param", "key": "face.eye_dx", "default": 0.0, "step": 0.003, "per": null},
  "eye.tilt": {"kind": "param", "key": "face.eye_tilt", "default": 0.12, "step": 0.05, "per": null},
  "eye.open": {"kind": "param", "key": "face.eye_h", "default": 0.8, "step": 0.12, "per": null},
  "brow.thickness": {"kind": "param", "key": "face.brow_w", "default": 0.0035, "step": 0.0012, "per": null},
  "brow.arch": {"kind": "param", "key": "face.brow_arch", "default": 0.004, "step": 0.003, "per": null},
  "brow.slant": {"kind": "sculpt", "note": "acg_face has no brow tilt value yet; add one, then bake as param"},
  "brow.length": {"kind": "param", "key": "face.brow_spread", "default": 1.08, "step": 0.1, "per": null},
  "brow.gap": {"kind": "sculpt", "note": "acg_face has no brow inner-end offset yet; add one, then bake as param"},
  "ear.scale": {"kind": "param", "key": "face.ear_scale", "default": 0.75, "step": 0.1, "per": null, "note": "shrink_ears runs after the targets, so the ACG ear size is this value, not ear-scale targets"},
  "ear.elfShare": {"kind": "target", "pos": ["l-ear-shape-pointed", "r-ear-shape-pointed"], "per": 1, "note": "stand-in until the race's own elf ear is modelled"},
  "ear.goblinShare": {"kind": "target", "pos": ["l-ear-wing-incr", "r-ear-wing-incr"], "per": 1, "note": "stand-in until the race's own goblin ear is modelled"},
  "ear.wolfShare": {"kind": "target", "pos": ["l-ear-shape-triangle", "r-ear-shape-triangle"], "per": 1, "note": "stand-in; the furred ear itself is a rigid part (npc-uma-looks.md #12)"},
  "ear.finShare": {"kind": "target", "pos": ["l-ear-shape-square", "r-ear-shape-square"], "per": 1, "note": "stand-in; the ear fin itself is a rigid part (npc-uma-looks.md #12)"},

  "beard.length": {"kind": "slot", "note": "beard slot blendshape"},
  "cloth.fall": {"kind": "slot", "note": "garment hem blendshape"},
  "cloth.textile": {"kind": "shader", "note": "trim width and dye set"}
 }
}

#!/usr/bin/env sh
# Wrapper so CLAUDE.md / CI can call `tools/validate-data` with a POSIX shell (Git Bash on Windows).
PY=
# FENCE: Windows ships a `python3` Store-alias stub that exits 49 without running anything,
#        so probe each candidate instead of trusting `command -v` · run `python3 -c ""` on Windows · seen 2026-11-06
for c in python3 python; do
  if "$c" -c "import sys; sys.exit(sys.version_info < (3, 9))" >/dev/null 2>&1; then PY=$c; break; fi
done
if [ -z "$PY" ]; then
  echo "error: python 3 not found" >&2
  exit 2
fi
exec "$PY" "$(dirname "$0")/validate_data.py" "$@"

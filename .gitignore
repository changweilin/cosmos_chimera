# ==============================================================================
# Project-Specific Pipelines & Staging
# ==============================================================================
# Offline-baked geodata intermediates (P3-02); only the final template packs are committed
/tools/geodata/_cache/

# AI batch staging is reviewed before promotion; raw batches can be large
/Data/_incoming/**/raw/

# D0 demo staging of draft batches (tools/demo-data/merge.py); regenerate, never edit
/Data/_demo/

# Unreviewed AI art deliveries (tools/prompt-forge); only promoted assets under Assets/ are committed
/Art/_incoming/*
!/Art/_incoming/README.md

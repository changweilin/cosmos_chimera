    kind: 2
    note: "\u4F4E\u4F0F\u8352\u539F\u7684\u70C8\u7130\u96C4\u7345\u8207\u5954\u99B3\u7DA0\u8349\u539F\u7684\u96FB\u9B03\u99FF\u99AC\u5177\u63A0\u98DF\u5929\u6575\u5C0D\u5CD9\u610F\u8C61"
  - a: {fileID: 11400000, guid: 5004155136d050441a62e726e406d197, type: 2}

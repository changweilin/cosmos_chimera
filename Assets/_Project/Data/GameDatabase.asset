    kind: 2
    note: "\u5CA9\u93A7\u77F3\u5076\u4EE5\u5CA9\u6BBC\u8B77\u4F4F\u7802\u5CA9\u7194\u6838\u5E7C\u7345\u7684\u9918\u71FC\uFF08\u5E7C\u5E74\u5916\u89C0\u5C1A\u7121\u5CA9\u6BBC\uFF0C\u53D6\u7DDA\u57FA\u5E95\uFF09"
  - a: {fileID: 11400000, guid: 1e7730fbf9dbd7445b33fff2f68c8d76, type: 2}
    b: {fileID: 11400000, guid: c4d01b44568137545abd82c48d06f4e7, type: 2}
    kind: 4
    note: "\u96D9\u8DB3\u5982\u6A01\u5B88\u9663\u7684\u6F0F\u8F2A\u5DE8\u8C61\u6307\u5C0E\u6162\u6B65\u8DDF\u96A8\u524D\u6392\u7684\u91D1\u5875\u5076\u93AE\u5B88\u9663\u7DDA"
  - a: {fileID: 11400000, guid: 8dd401843768cf44b94ff0db2617c23f, type: 2}
    b: {fileID: 11400000, guid: b1cd4c1c76d6ca44ea0ff548089c2f32, type: 2}
    kind: 4
    note: "\u6C89\u7A69\u7E5E\u80CC\u4F0F\u8972\u7684\u591C\u75D5\u971C\u72FC\u6559\u5C0E\u6025\u8E81\u6436\u524D\u7684\u71FC\u9B03\u4ED4\u4F4E\u4F0F\u4F3A\u6A5F\u7A81\u64CA"

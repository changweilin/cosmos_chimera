/* AdventureHandbook (Backpack / Partners / Skills / Codex) */

.handbook-shell {
    width: 92%;
    max-width: 1120px;
    height: 88%;
    flex-direction: column;
}

.handbook-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    margin-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(51, 65, 85);
}

.handbook-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.tab-btn {
    background-color: rgb(30, 41, 59);
    border-width: 1px;
    border-color: rgb(51, 65, 85);
    border-radius: 8px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-right: 8px;
    color: rgb(203, 213, 225);
    font-size: 14px;
    -unity-font-style: bold;
    transition-duration: 0.12s;
}

.tab-btn:hover {
    background-color: rgb(51, 65, 85);
    border-color: rgb(56, 189, 248);
    color: rgb(255, 255, 255);
}

.tab-btn-active {
    background-color: rgb(2, 132, 199);
    border-color: rgb(125, 211, 252);
    color: rgb(255, 255, 255);
}

.handbook-close-btn {
    margin-bottom: 0;
    padding-left: 16px;
    padding-right: 16px;
}

.handbook-nav-hint {
    margin-bottom: 8px;
}

.handbook-status {
    background-color: rgb(12, 74, 110);
    border-width: 1px;
    border-color: rgb(56, 189, 248);
    border-radius: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 10px;
    color: rgb(224, 242, 254);
    font-size: 14px;
    -unity-font-style: bold;
}

.handbook-scroll {
    flex-grow: 1;
    padding-right: 6px;
}

.handbook-section {
    background-color: rgb(20, 29, 48);
    border-width: 1px;
    border-color: rgb(42, 56, 82);
    border-radius: 10px;
    padding: 14px;
    margin-bottom: 12px;
}

.handbook-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
}

.handbook-item-card {
    background-color: rgb(30, 41, 59);
    border-width: 1px;
    border-color: rgb(51, 65, 85);
    border-radius: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 6px;
}

.handbook-item-label {
    font-size: 14px;
    color: rgb(226, 232, 240);
    white-space: normal;
    margin-bottom: 4px;
}

.handbook-action-btn {
    align-self: flex-start;
    min-width: 180px;
}

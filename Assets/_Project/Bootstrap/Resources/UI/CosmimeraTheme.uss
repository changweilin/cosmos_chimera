/* Shared Cosmimera UI Toolkit Theme (BotW Warm Ink & Gold + PLA Accent Palette) */

.hidden {
    display: none;
}

.screen-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 13, 18, 0.84);
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.panel-shell {
    background-color: rgb(18, 22, 28);
    border-width: 1px;
    border-color: rgba(198, 166, 102, 0.55);
    border-radius: 12px;
    padding: 20px;
}

.card {
    background-color: rgb(25, 31, 39);
    border-width: 1px;
    border-color: rgba(146, 132, 102, 0.38);
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 8px;
}

.card-accent {
    background-color: rgb(26, 36, 48);
    border-width: 1px;
    border-color: rgb(198, 166, 102);
    border-radius: 8px;
    padding: 12px;
    margin-bottom: 8px;
}

.title-xl {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(245, 241, 232);
}

.heading-lg {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(232, 206, 148);
    margin-top: 8px;
    margin-bottom: 6px;
}

.body-text {
    font-size: 14px;
    color: rgb(238, 233, 222);
    white-space: normal;
}

.muted-text {
    font-size: 13px;
    color: rgb(188, 180, 164);
    white-space: normal;
}

.btn {
    background-color: rgb(34, 41, 51);
    border-width: 1px;
    border-color: rgba(198, 166, 102, 0.45);
    border-radius: 6px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
    color: rgb(245, 241, 232);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    transition-duration: 0.12s;
}

.btn:hover {
    background-color: rgb(48, 57, 70);
    border-color: rgb(232, 206, 148);
}

.btn:active {
    background-color: rgb(142, 114, 62);
}

.btn:disabled {
    opacity: 0.45;
}

.btn-primary {
    background-color: rgb(42, 74, 102);
    border-color: rgb(138, 180, 214);
    color: rgb(248, 245, 238);
}

.btn-primary:hover {
    background-color: rgb(56, 94, 128);
    border-color: rgb(232, 206, 148);
}

.btn-accent {
    background-color: rgb(156, 108, 34);
    border-color: rgb(232, 192, 110);
    color: rgb(255, 252, 244);
}

.btn-accent:hover {
    background-color: rgb(184, 130, 44);
}

.btn-danger {
    background-color: rgb(124, 38, 38);
    border-color: rgb(220, 96, 86);
    color: rgb(254, 232, 228);
}

.btn-danger:hover {
    background-color: rgb(152, 46, 46);
}

.btn-focused {
    background-color: rgb(62, 88, 114);
    border-width: 2px;
    border-color: rgb(240, 212, 140);
}

.badge {
    border-radius: 999px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 12px;
    -unity-font-style: bold;
    margin-right: 6px;
}

.badge-info {
    background-color: rgb(32, 58, 84);
    color: rgb(186, 216, 244);
}

.badge-ok {
    background-color: rgb(34, 82, 62);
    color: rgb(172, 236, 200);
}

.badge-warn {
    background-color: rgb(116, 78, 28);
    color: rgb(250, 216, 132);
}

.badge-err {
    background-color: rgb(124, 38, 38);
    color: rgb(252, 186, 180);
}

.text-input {
    margin-top: 4px;
    margin-bottom: 8px;
}

.text-input > .unity-text-field__input {
    background-color: rgb(14, 18, 24);
    border-width: 1px;
    border-color: rgba(198, 166, 102, 0.55);
    border-radius: 6px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    color: rgb(245, 241, 232);
    font-size: 14px;
}

.text-input > .unity-text-field__input:focus {
    border-color: rgb(232, 206, 148);
}

.bar-track {
    height: 7px;
    background-color: rgba(12, 15, 20, 0.90);
    border-radius: 4px;
    overflow: hidden;
}

.bar-fill-hp {
    height: 100%;
    background-color: rgb(92, 198, 132);
    border-radius: 4px;
}

.bar-fill-boss {
    height: 100%;
    background-color: rgb(206, 56, 50);
    border-radius: 3px;
}

.bar-fill-stamina {
    height: 100%;
    background-color: rgb(112, 196, 232);
    border-radius: 4px;
}

.key-pill {
    flex-direction: row;
    align-items: center;
    background-color: rgba(16, 20, 26, 0.78);
    border-width: 1px;
    border-color: rgba(198, 166, 102, 0.45);
    border-radius: 6px;
    padding-left: 5px;
    padding-right: 9px;
    padding-top: 3px;
    padding-bottom: 3px;
    margin-right: 8px;
    margin-bottom: 4px;
}

.key-glyph {
    background-color: rgb(245, 240, 228);
    border-width: 1px;
    border-color: rgb(198, 166, 102);
    border-radius: 4px;
    color: rgb(24, 26, 32);
    font-size: 12px;
    -unity-font-style: bold;
    min-width: 22px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 1px;
    padding-bottom: 1px;
    -unity-text-align: middle-center;
    margin-right: 6px;
}

.key-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(245, 241, 232);
}

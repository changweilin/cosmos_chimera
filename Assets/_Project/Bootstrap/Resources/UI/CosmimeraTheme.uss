/* Shared Cosmimera UI Toolkit Theme */

.hidden {
    display: none;
}

.screen-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(7, 11, 22, 0.86);
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.panel-shell {
    background-color: rgb(15, 23, 42);
    border-width: 1px;
    border-color: rgb(51, 65, 85);
    border-radius: 14px;
    padding: 20px;
}

.card {
    background-color: rgb(24, 34, 56);
    border-width: 1px;
    border-color: rgb(51, 65, 85);
    border-radius: 10px;
    padding: 12px;
    margin-bottom: 8px;
}

.card-accent {
    background-color: rgb(20, 38, 64);
    border-width: 1px;
    border-color: rgb(56, 189, 248);
    border-radius: 10px;
    padding: 12px;
    margin-bottom: 8px;
}

.title-xl {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(248, 250, 252);
}

.heading-lg {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(125, 211, 252);
    margin-top: 10px;
    margin-bottom: 6px;
}

.body-text {
    font-size: 14px;
    color: rgb(226, 232, 240);
    white-space: normal;
}

.muted-text {
    font-size: 12px;
    color: rgb(148, 163, 184);
    white-space: normal;
}

.btn {
    background-color: rgb(30, 41, 59);
    border-width: 1px;
    border-color: rgb(71, 85, 105);
    border-radius: 8px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 8px;
    padding-bottom: 8px;
    color: rgb(241, 245, 249);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    transition-duration: 0.12s;
}

.btn:hover {
    background-color: rgb(51, 65, 85);
    border-color: rgb(56, 189, 248);
}

.btn:active {
    background-color: rgb(14, 116, 144);
}

.btn:disabled {
    opacity: 0.45;
}

.btn-primary {
    background-color: rgb(2, 132, 199);
    border-color: rgb(56, 189, 248);
    color: rgb(255, 255, 255);
}

.btn-primary:hover {
    background-color: rgb(14, 165, 233);
}

.btn-accent {
    background-color: rgb(217, 119, 6);
    border-color: rgb(251, 191, 36);
    color: rgb(255, 255, 255);
}

.btn-accent:hover {
    background-color: rgb(245, 158, 11);
}

.btn-danger {
    background-color: rgb(127, 29, 29);
    border-color: rgb(239, 68, 68);
    color: rgb(254, 226, 226);
}

.btn-danger:hover {
    background-color: rgb(153, 27, 27);
}

.btn-focused {
    background-color: rgb(3, 105, 161);
    border-width: 2px;
    border-color: rgb(125, 211, 252);
}

.badge {
    border-radius: 999px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 12px;
    -unity-font-style: bold;
    margin-right: 6px;
}

.badge-info {
    background-color: rgb(12, 74, 110);
    color: rgb(125, 211, 252);
}

.badge-ok {
    background-color: rgb(6, 78, 59);
    color: rgb(110, 231, 183);
}

.badge-warn {
    background-color: rgb(120, 53, 15);
    color: rgb(252, 211, 77);
}

.badge-err {
    background-color: rgb(127, 29, 29);
    color: rgb(252, 165, 165);
}

.text-input {
    margin-top: 4px;
    margin-bottom: 8px;
}

.text-input > .unity-text-field__input {
    background-color: rgb(2, 6, 23);
    border-width: 1px;
    border-color: rgb(71, 85, 105);
    border-radius: 8px;
    padding: 8px 12px;
    color: rgb(248, 250, 252);
    font-size: 14px;
}

.text-input > .unity-text-field__input:focus {
    border-color: rgb(56, 189, 248);
}

.bar-track {
    height: 8px;
    background-color: rgb(15, 23, 42);
    border-radius: 4px;
    overflow: hidden;
}

.bar-fill-hp {
    height: 100%;
    background-color: rgb(34, 197, 94);
    border-radius: 4px;
}

.bar-fill-boss {
    height: 100%;
    background-color: rgb(239, 68, 68);
    border-radius: 4px;
}

.bar-fill-stamina {
    height: 100%;
    background-color: rgb(56, 189, 248);
    border-radius: 4px;
}

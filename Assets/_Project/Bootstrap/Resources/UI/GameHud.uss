/* In-Game HUD (BotW low-noise ink & bronze style + PLA quest/dialogue elements) */

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 14px;
    padding-bottom: 14px;
    justify-content: space-between;
}

.hud-top-row {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.hud-col-left {
    width: 316px;
    flex-direction: column;
}

.hud-col-center {
    flex-grow: 1;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
}

.hud-col-right {
    width: 268px;
    flex-direction: column;
    align-items: flex-end;
}

.hud-card {
    background-color: rgba(16, 20, 26, 0.78);
    border-width: 1px;
    border-color: rgba(198, 166, 102, 0.42);
    border-radius: 8px;
    padding: 10px;
    margin-bottom: 8px;
}

/* Top-left PLA Quest Card */
.hud-quest-card {
    flex-direction: row;
    background-color: rgba(16, 20, 26, 0.74);
    border-width: 1px;
    border-color: rgba(198, 166, 102, 0.40);
    border-radius: 6px;
    margin-bottom: 8px;
    overflow: hidden;
}

.hud-quest-stripe {
    width: 4px;
    background-color: rgb(198, 166, 102);
}

.hud-quest-card-main .hud-quest-stripe {
    background-color: rgb(206, 78, 60);
}

.hud-quest-content {
    flex-grow: 1;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
}

.hud-quest-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 3px;
}

.hud-quest-tag {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(232, 206, 148);
    background-color: rgba(198, 166, 102, 0.18);
    border-radius: 4px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 1px;
    padding-bottom: 1px;
}

.hud-quest-card-main .hud-quest-tag {
    color: rgb(254, 226, 218);
    background-color: rgba(198, 72, 58, 0.72);
}

.hud-quest-compass {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(245, 241, 232);
    background-color: rgba(30, 38, 48, 0.85);
    border-width: 1px;
    border-color: rgba(198, 166, 102, 0.48);
    border-radius: 999px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 1px;
    padding-bottom: 1px;
}

.hud-quest-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(245, 241, 232);
    margin-bottom: 2px;
    white-space: normal;
}

.hud-quest-body {
    font-size: 13px;
    color: rgb(228, 222, 210);
    white-space: normal;
}

.hud-quest-meta {
    font-size: 12px;
    color: rgb(188, 180, 164);
    margin-top: 4px;
    white-space: normal;
}

/* Slim BotW-style player status strip */
.hud-player-card {
    background-color: rgba(16, 20, 26, 0.72);
    border-width: 1px;
    border-color: rgba(198, 166, 102, 0.36);
    border-radius: 6px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 7px;
    padding-bottom: 7px;
}

.hud-player-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.hud-player-roll {
    font-size: 12px;
    color: rgb(226, 212, 174);
}

.hud-player-track {
    height: 6px;
    background-color: rgba(12, 14, 18, 0.90);
    border-radius: 3px;
    overflow: hidden;
}

/* Top-center BotW Boss Health Bar */
.hud-boss-card {
    width: 100%;
    max-width: 540px;
    background-color: rgba(14, 17, 22, 0.82);
    border-width: 1px;
    border-color: rgba(198, 166, 102, 0.72);
    border-radius: 6px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 8px;
    padding-bottom: 9px;
    margin-bottom: 8px;
}

.hud-boss-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 5px;
}

.hud-boss-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(248, 242, 230);
}

.hud-boss-hp-text {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(232, 206, 148);
}

.hud-boss-track {
    height: 10px;
    background-color: rgba(24, 10, 12, 0.92);
    border-width: 1px;
    border-color: rgba(198, 166, 102, 0.55);
    border-radius: 4px;
    overflow: hidden;
}

.hud-boss-tick-33 {
    position: absolute;
    left: 33%;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: rgba(245, 241, 232, 0.78);
}

.hud-boss-tick-66 {
    position: absolute;
    left: 66%;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: rgba(245, 241, 232, 0.78);
}

/* Non-blocking BotW Tutorial Banner */
.hud-tutorial-banner {
    max-width: 560px;
    background-color: rgba(14, 18, 24, 0.78);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 0;
    border-right-width: 0;
    border-color: rgba(212, 182, 118, 0.75);
    border-radius: 4px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 6px;
    align-items: center;
}

.hud-tutorial-header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 5px;
}

.hud-tutorial-badge {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(24, 22, 18);
    background-color: rgb(232, 206, 148);
    border-radius: 4px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 1px;
    padding-bottom: 1px;
    margin-right: 8px;
}

.hud-tutorial-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(245, 241, 232);
    white-space: normal;
}

.hud-tutorial-keys {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

/* Top-right Journal button & low-noise Team Strip */
.hud-actions-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.hud-journal-btn {
    background-color: rgba(16, 20, 26, 0.76);
    border-width: 1px;
    border-color: rgba(198, 166, 102, 0.62);
    border-radius: 999px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 6px;
    color: rgb(245, 241, 232);
    font-size: 13px;
    -unity-font-style: bold;
    transition-duration: 0.12s;
}

.hud-journal-btn:hover {
    background-color: rgba(42, 50, 62, 0.88);
    border-color: rgb(232, 206, 148);
}

.hud-team-list {
    width: 100%;
    align-items: flex-end;
}

.hud-member-card {
    width: 92%;
    background-color: rgba(16, 20, 26, 0.62);
    border-width: 1px;
    border-color: rgba(140, 134, 118, 0.30);
    border-radius: 6px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 5px;
    padding-bottom: 5px;
    margin-bottom: 4px;
    opacity: 0.82;
}

.hud-member-active {
    width: 100%;
    background-color: rgba(20, 28, 38, 0.84);
    border-color: rgba(212, 182, 118, 0.72);
    border-left-width: 3px;
    border-left-color: rgb(232, 206, 148);
    opacity: 1;
}

.hud-member-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3px;
}

.hud-member-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(245, 241, 232);
}

.hud-member-hp-label {
    font-size: 11px;
    color: rgb(212, 204, 188);
}

/* Bottom Key Prompt Bar (BotW) */
.hud-bottom-row {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
}

.hud-keybar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.hud-controls-card {
    max-width: 380px;
}

/* Center-bottom Prompts: PLA Quest Scroll Toast, Interact Bubble, Menu & Dialogue Box */
.hud-center-prompts {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 62px;
    align-items: center;
}

.hud-toast {
    background-color: rgba(18, 22, 28, 0.90);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 0;
    border-right-width: 0;
    border-color: rgb(212, 182, 118);
    border-radius: 4px;
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-bottom: 10px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(244, 222, 168);
}

.hud-interact-bubble {
    flex-direction: row;
    align-items: center;
    background-color: rgba(16, 20, 26, 0.86);
    border-width: 1px;
    border-color: rgba(212, 182, 118, 0.78);
    border-radius: 999px;
    padding-left: 10px;
    padding-right: 16px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-bottom: 8px;
}

.hud-interact-key {
    margin-right: 8px;
}

.hud-interact-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(248, 244, 234);
}

.hud-interact-menu {
    width: 340px;
    background-color: rgba(16, 20, 26, 0.94);
    border-width: 1px;
    border-color: rgba(212, 182, 118, 0.75);
    border-radius: 10px;
    padding: 14px;
    margin-bottom: 10px;
}

/* PLA-style Character Dialogue Box */
.hud-dialogue-box {
    width: 72%;
    max-width: 740px;
    min-height: 92px;
    background-color: rgba(246, 241, 229, 0.96);
    border-width: 2px;
    border-color: rgb(164, 134, 82);
    border-radius: 10px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 12px;
    padding-bottom: 12px;
    margin-bottom: 6px;
}

.hud-dialogue-speaker {
    align-self: flex-start;
    margin-top: -24px;
    margin-bottom: 6px;
    background-color: rgb(36, 48, 66);
    border-width: 1px;
    border-color: rgb(212, 182, 118);
    border-radius: 6px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(248, 243, 232);
}

.hud-dialogue-body {
    font-size: 16px;
    color: rgb(38, 33, 28);
    white-space: normal;
}

.hud-dialogue-advance {
    align-self: flex-end;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(176, 62, 48);
    margin-top: 4px;
}

.hud-loading-pill {
    background-color: rgba(16, 20, 26, 0.92);
    border-width: 1px;
    border-color: rgba(212, 182, 118, 0.75);
    border-radius: 8px;
    padding: 14px 24px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(245, 241, 232);
}

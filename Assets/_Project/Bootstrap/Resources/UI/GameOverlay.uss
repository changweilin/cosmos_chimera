/* GameOverlay (StarSelect / Results / MainStorySelect / QuickMenu) */

.overlay-shell {
    width: 90%;
    max-width: 780px;
    max-height: 86%;
    flex-direction: column;
}

.overlay-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(51, 65, 85);
}

.overlay-scroll {
    flex-grow: 1;
    padding-right: 6px;
}

.overlay-footer {
    flex-direction: row;
    justify-content: flex-end;
    padding-top: 12px;
    margin-top: 10px;
    border-top-width: 1px;
    border-top-color: rgb(51, 65, 85);
}

.overlay-footer-btn {
    margin-left: 8px;
    margin-bottom: 0;
}

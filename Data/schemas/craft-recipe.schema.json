{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmimera.local/schemas/craft-recipe.schema.json",
  "title": "Atomic crafting recipe array",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "utility",
      "costs",
      "gains"
    ],
    "properties": {
      "id": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "utility": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/fieldUtility"
          },
          {
            "not": {
              "const": "none"
            }
          }
        ]
      },
      "costs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item",
            "quantity"
          ],
          "properties": {
            "item": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        }
      },
      "gains": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item",
            "quantity"
          ],
          "properties": {
            "item": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        }
      },
      "tools": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "$ref": "common.schema.json#/$defs/id"
        }
      }
    }
  }
}

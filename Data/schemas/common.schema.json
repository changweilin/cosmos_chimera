{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmimera.local/schemas/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "id": {
      "description": "Globally unique, never reused (data-content.md). Saves and net packets reference it.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
      "maxLength": 64
    },
    "element": {
      "description": "The ten elements (creatures.md#十大屬性).",
      "enum": ["metal", "wood", "water", "fire", "earth", "ice", "wind", "thunder", "light", "shadow"]
    },
    "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
    "nonNegativeInt": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "positiveInt": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "movePower": {
      "description": "DamageModel.MaxPower representability bound; not a balance target.",
      "type": "integer", "minimum": 0, "maximum": 100000
    },
    "masteryPercent": {
      "description": "DamageModel.MaxMasteryPercent representability bound. P2-09 must keep effective mastery, including modifiers, in 0..1000.",
      "type": "integer", "minimum": 0, "maximum": 1000
    },
    "resistPercent": {
      "description": "Negative = weakness. combat.md clamps to ±100, so values beyond that are meaningless.",
      "type": "integer",
      "minimum": -100,
      "maximum": 100
    },
    "elementOrAny": {
      "description": "An element, or \"any\" to match every element.",
      "anyOf": [{ "$ref": "#/$defs/element" }, { "const": "any" }]
    },
    "rulePercent": { "description": "Percent threshold or amount inside a rule.", "type": "integer", "minimum": 1, "maximum": 100 },
    "durationMs": { "description": "Effect window. 10 min cap is representability, not balance.", "type": "integer", "minimum": 1, "maximum": 600000 },
    "ruleDelta": {
      "description": "Signed modifier in percent or percentage points. ±100 is representability; balance bands live in the batch prompts.",
      "type": "integer",
      "minimum": -100,
      "maximum": 100
    },
    "trigger": {
      "description": "Closed trigger vocabulary (P2-01, adopted from the P5-05 provisional set). Adding a type = this enum + GameData TriggerType + a P2-09 handler.",
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["always", "on_hp_below", "on_hp_above", "on_summon", "on_hit_taken", "on_move_used", "on_ally_swap", "on_hp_cross_below"] },
        "params": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "always" } } }, "then": { "properties": { "params": { "type": "object", "maxProperties": 0 } } } },
        { "if": { "properties": { "type": { "const": "on_hp_below" } } }, "then": { "required": ["params"], "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["percent"], "properties": { "percent": { "$ref": "#/$defs/rulePercent" } } } } } },
        { "if": { "properties": { "type": { "const": "on_hp_above" } } }, "then": { "required": ["params"], "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["percent"], "properties": { "percent": { "$ref": "#/$defs/rulePercent" } } } } } },
        { "if": { "properties": { "type": { "const": "on_summon" } } }, "then": { "required": ["params"], "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["duration_ms"], "properties": { "duration_ms": { "$ref": "#/$defs/durationMs" } } } } } },
        { "if": { "properties": { "type": { "const": "on_hit_taken" } } }, "then": { "required": ["params"], "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["element", "duration_ms"], "properties": { "element": { "$ref": "#/$defs/elementOrAny" }, "duration_ms": { "$ref": "#/$defs/durationMs" } } } } } },
        { "if": { "properties": { "type": { "const": "on_move_used" } } }, "then": { "required": ["params"], "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["element", "duration_ms"], "properties": { "element": { "$ref": "#/$defs/element" }, "duration_ms": { "$ref": "#/$defs/durationMs" } } } } } },
        { "if": { "properties": { "type": { "const": "on_ally_swap" } } }, "then": { "required": ["params"], "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["duration_ms"], "properties": { "duration_ms": { "$ref": "#/$defs/durationMs" } } } } } },
        { "if": { "properties": { "type": { "const": "on_hp_cross_below" } } }, "then": { "required": ["params"], "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["percent", "duration_ms"], "properties": { "percent": { "$ref": "#/$defs/rulePercent" }, "duration_ms": { "$ref": "#/$defs/durationMs" } } } } } }
      ]
    },
    "effect": {
      "description": "Closed effect vocabulary shared by trait effects and move effects (P2-01). Adding a type = this enum + GameData EffectType + a P2-09 handler.",
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["mastery_mod", "resist_mod", "cd_mod_percent", "evasion_mod_percent", "move_speed_mod_percent", "range_mod_percent", "heal_percent_max_hp"] },
        "params": { "type": "object" },
        "max_stacks": {
          "description": "P2-09: how many times this effect can stack on one target from the same move/trait id. 1 (default) = re-application only refreshes the duration. Not allowed on instant heals.",
          "type": "integer", "minimum": 1, "maximum": 10, "default": 1
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "heal_percent_max_hp" } } }, "then": { "not": { "required": ["max_stacks"] } } },
        { "if": { "properties": { "type": { "const": "mastery_mod" } } }, "then": { "required": ["params"], "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["element", "delta"], "properties": { "element": { "$ref": "#/$defs/element" }, "delta": { "$ref": "#/$defs/ruleDelta" } } } } } },
        { "if": { "properties": { "type": { "const": "resist_mod" } } }, "then": { "required": ["params"], "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["element", "delta"], "properties": { "element": { "$ref": "#/$defs/element" }, "delta": { "$ref": "#/$defs/ruleDelta" } } } } } },
        { "if": { "properties": { "type": { "const": "cd_mod_percent" } } }, "then": { "required": ["params"], "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["element", "delta"], "properties": { "element": { "$ref": "#/$defs/elementOrAny" }, "delta": { "$ref": "#/$defs/ruleDelta" } } } } } },
        { "if": { "properties": { "type": { "const": "evasion_mod_percent" } } }, "then": { "required": ["params"], "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["delta"], "properties": { "delta": { "$ref": "#/$defs/ruleDelta" } } } } } },
        { "if": { "properties": { "type": { "const": "move_speed_mod_percent" } } }, "then": { "required": ["params"], "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["delta"], "properties": { "delta": { "$ref": "#/$defs/ruleDelta" } } } } } },
        { "if": { "properties": { "type": { "const": "range_mod_percent" } } }, "then": { "required": ["params"], "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["delta"], "properties": { "delta": { "$ref": "#/$defs/ruleDelta" } } } } } },
        { "if": { "properties": { "type": { "const": "heal_percent_max_hp" } } }, "then": { "required": ["params"], "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["percent"], "properties": { "percent": { "$ref": "#/$defs/rulePercent" } } } } } }
      ]
    }
  }
}

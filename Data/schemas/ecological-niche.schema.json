{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmimera.local/schemas/ecological-niche.schema.json",
  "title": "Ecological niche proposal catalog (P3-31; not imported yet)",
  "description": "REQ: docs/design/creature-ecology.md. Draft numeric proposals stay under Data/_incoming until reviewed. Cross-field ordering and ID uniqueness require semantic validation.",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/$defs/niche" },
  "$defs": {
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean", "individual_sd", "action_sd", "min", "max"],
      "properties": {
        "mean": { "$ref": "common.schema.json#/$defs/positiveInt" },
        "individual_sd": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
        "action_sd": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
        "min": { "$ref": "common.schema.json#/$defs/positiveInt" },
        "max": { "$ref": "common.schema.json#/$defs/positiveInt" }
      }
    },
    "niche": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name_zh", "resource_zh", "habitat_kinds", "temperament_weights", "wander"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "name_zh": { "type": "string", "minLength": 1 },
        "resource_zh": { "type": "string", "minLength": 1 },
        "habitat_kinds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/id" }
        },
        "temperament_weights": {
          "type": "object", "minProperties": 1,
          "propertyNames": { "enum": ["timid", "cautious", "normal", "territorial", "fierce", "apex"] },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/positiveInt" }
        },
        "wander": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "radius_mm", "speed_permille", "move_ms", "pause_ms"],
          "properties": {
            "mode": { "enum": ["shuttle", "loop", "bounded_random", "unbounded_random"] },
            "radius_mm": { "oneOf": [{ "$ref": "common.schema.json#/$defs/positiveInt" }, { "type": "null" }] },
            "speed_permille": { "$ref": "#/$defs/distribution" },
            "move_ms": { "$ref": "#/$defs/distribution" },
            "pause_ms": { "$ref": "#/$defs/distribution" }
          },
          "allOf": [{
            "if": { "properties": { "mode": { "const": "unbounded_random" } }, "required": ["mode"] },
            "then": { "properties": { "radius_mm": { "type": "null" } } },
            "else": { "properties": { "radius_mm": { "$ref": "common.schema.json#/$defs/positiveInt" } } }
          }]
        }
      }
    }
  }
}

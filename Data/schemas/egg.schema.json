{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmimera.local/schemas/egg.schema.json",
  "title": "Egg definitions (hatchery outcomes)",
  "description": "REQ: docs/design/lobby-meta.md#收服與蛋 (Q-M3). Which species an egg can hatch into; progress rules live in Capture/EggHatchery.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "outcomes"],
    "additionalProperties": false,
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/id" },
      "outcomes": {
        "description": "Weighted hatch pool; species must be juvenile creatures (hatchlings start at LV1).",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["species", "weight"],
          "additionalProperties": false,
          "properties": {
            "species": { "$ref": "common.schema.json#/$defs/id" },
            "weight": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        }
      }
    }
  }
}

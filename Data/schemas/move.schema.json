{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmimera.local/schemas/move.schema.json",
  "title": "Move file (array of moves)",
  "description": "REQ: docs/design/creatures.md#招式, docs/design/combat.md",
  "type": "array",
  "items": { "$ref": "#/$defs/move" },
  "$defs": {
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "element", "kind", "power", "cooldown_ms", "accuracy", "range_class", "shape", "base_range_mm"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "element": { "$ref": "common.schema.json#/$defs/element" },
        "kind": { "enum": ["damage", "effect", "both"] },
        "power": { "$ref": "common.schema.json#/$defs/movePower" },
        "effect": { "$ref": "common.schema.json#/$defs/effect" },
        "cooldown_ms": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
        "accuracy": { "$ref": "common.schema.json#/$defs/percent" },
        "range_class": { "enum": ["melee", "mid", "long"] },
        "shape": {
          "enum": ["front", "sweep", "burst", "line", "cone", "arc", "self", "ally", "field"]
        },
        "base_range_mm": {
          "description": "Per-move base geometric range before STR scaling; burst radius or dash path length. Not a range_class lookup.",
          "$ref": "common.schema.json#/$defs/nonNegativeInt"
        },
        "movement": { "enum": ["none", "dash"], "default": "none" },
        "origin": { "description": "Burst center only.", "enum": ["caster", "target"] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "damage" } } },
          "then": { "not": { "required": ["effect"] } },
          "else": { "required": ["effect"] }
        },
        {
          "if": { "properties": { "shape": { "const": "burst" } } },
          "then": { "required": ["origin"] },
          "else": { "not": { "required": ["origin"] } }
        },
        {
          "if": { "required": ["movement"], "properties": { "movement": { "const": "dash" } } },
          "then": { "properties": { "shape": { "const": "line" }, "base_range_mm": { "minimum": 1 } } }
        }
      ]
    }
  }
}

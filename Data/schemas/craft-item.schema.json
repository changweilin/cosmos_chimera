{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmimera.local/schemas/craft-item.schema.json",
  "title": "Gathering and crafting item array",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "category",
      "sources",
      "utility",
      "quantity",
      "season"
    ],
    "properties": {
      "id": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "category": {
        "enum": [
          "raw",
          "processed",
          "capture",
          "trap",
          "tool",
          "equipment"
        ]
      },
      "sources": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "$ref": "common.schema.json#/$defs/id"
        }
      },
      "utility": {
        "$ref": "common.schema.json#/$defs/fieldUtility"
      },
      "quantity": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      },
      "season": {
        "enum": [
          "all",
          "spring",
          "summer",
          "autumn",
          "winter"
        ]
      },
      "gather_tool": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "capture_bonus_percent": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "equipment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "target",
          "player",
          "creature_effects"
        ],
        "properties": {
          "kind": {
            "enum": [
              "one_handed",
              "two_handed",
              "shield",
              "upper",
              "lower",
              "accessory"
            ]
          },
          "target": {
            "enum": [
              "player",
              "creature",
              "both"
            ]
          },
          "player": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_hp_percent",
              "move_speed_percent",
              "roll_cooldown_percent"
            ],
            "properties": {
              "max_hp_percent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "move_speed_percent": {
                "type": "integer",
                "minimum": -50,
                "maximum": 100
              },
              "roll_cooldown_percent": {
                "type": "integer",
                "minimum": -50,
                "maximum": 100
              },
              "yin_defense": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "yang_defense": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            }
          },
          "creature_effects": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "allOf": [
                {
                  "$ref": "common.schema.json#/$defs/effect"
                },
                {
                  "properties": {
                    "type": {
                      "not": {
                        "const": "heal_percent_max_hp"
                      }
                    },
                    "max_stacks": {
                      "const": 1
                    }
                  }
                }
              ]
            }
          },
          "weapon": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "element",
              "element_mastery",
              "power_permille",
              "speed_permille"
            ],
            "properties": {
              "element": {
                "$ref": "common.schema.json#/$defs/element"
              },
              "element_mastery": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "power_permille": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "speed_permille": {
                "type": "integer",
                "minimum": 100,
                "maximum": 10000
              }
            }
          }
        },
        "if": {
          "properties": {
            "kind": {
              "enum": [
                "one_handed",
                "two_handed"
              ]
            }
          }
        },
        "then": {
          "required": [
            "weapon"
          ],
          "properties": {
            "target": {
              "not": {
                "const": "player"
              }
            },
            "player": {
              "properties": {
                "max_hp_percent": {
                  "const": 0
                },
                "move_speed_percent": {
                  "const": 0
                },
                "roll_cooldown_percent": {
                  "const": 0
                },
                "yin_defense": {
                  "const": 0
                },
                "yang_defense": {
                  "const": 0
                }
              }
            }
          }
        },
        "else": {
          "not": {
            "required": [
              "weapon"
            ]
          }
        }
      }
    },
    "allOf": [
      {
        "if": {
          "required": [
            "capture_bonus_percent"
          ]
        },
        "then": {
          "properties": {
            "category": {
              "const": "capture"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "sources": {
              "minItems": 1
            }
          }
        },
        "then": {
          "properties": {
            "utility": {
              "not": {
                "const": "none"
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "category": {
              "const": "equipment"
            }
          }
        },
        "then": {
          "required": [
            "equipment"
          ]
        },
        "else": {
          "not": {
            "required": [
              "equipment"
            ]
          }
        }
      }
    ]
  }
}

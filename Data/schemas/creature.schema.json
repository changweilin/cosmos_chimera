{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmimera.local/schemas/creature.schema.json",
  "title": "Creature file (array of creatures)",
  "description": "REQ: docs/design/creatures.md#資料模型. Cross-file refs (moves, traits, evolves_to chain) are checked by tools/validate-data.",
  "type": "array",
  "items": { "$ref": "#/$defs/creature" },
  "$defs": {
    "creature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "line_id", "stage", "size_class", "ai_style", "temperament", "evolves_to", "evolution", "resist", "mastery", "stats", "signature_move", "trait", "concept"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "line_id": { "$ref": "common.schema.json#/$defs/id" },
        "stage": { "enum": ["juvenile", "adolescent", "adult"] },
        "size_class": { "enum": ["XS", "S", "M", "L", "XL"] },
        "ai_style": {
          "description": "Combat AI positioning style. REQ: docs/design/combat.md#戰鬥 AI (Q-C21). Per stage: a line may change style as its signature move changes.",
          "enum": ["keep_distance", "flank", "charge", "hold"]
        },
        "temperament": {
          "description": "Wild territory radius class. REQ: docs/design/combat.md#野生領域 (D0-E2); radii in balance.json#ai.territory_mm (Q-C35).",
          "enum": ["timid", "cautious", "normal", "territorial", "fierce", "apex"]
        },
        "evolves_to": { "oneOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }] },
        "evolution": { "oneOf": [{ "$ref": "#/$defs/evolution" }, { "type": "null" }] },
        "resist": {
          "description": "All ten keys required: a missing key would silently read as 0 and hide authoring mistakes.",
          "type": "object",
          "required": ["metal", "wood", "water", "fire", "earth", "ice", "wind", "thunder", "light", "shadow"],
          "propertyNames": { "$ref": "common.schema.json#/$defs/element" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/resistPercent" }
        },
        "mastery": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 3,
          "propertyNames": { "$ref": "common.schema.json#/$defs/element" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/masteryPercent" }
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["con", "str", "spi", "agi"],
          "properties": {
            "con": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
            "str": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
            "spi": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
            "agi": { "$ref": "common.schema.json#/$defs/nonNegativeInt" }
          }
        },
        "signature_move": { "$ref": "common.schema.json#/$defs/id" },
        "trait": { "$ref": "common.schema.json#/$defs/id" },
        "concept": {
          "description": "Open by design: shaped by creature-concept-pipeline.md, not consumed by game rules.",
          "type": "object",
          "properties": {
            "sensitivity": { "enum": ["review"] }
          }
        }
      },
      "if": { "properties": { "stage": { "const": "adult" } } },
      "then": { "properties": { "evolves_to": { "type": "null" }, "evolution": { "type": "null" } } },
      "else": { "properties": { "evolves_to": { "type": "string" }, "evolution": { "type": "object" } } },
      "$comment": "REQ: docs/design/level-progression.md — level gate fixed per species, inclusive bands; mirrored by CreatureDef.EvolutionLevelMin/Max.",
      "allOf": [
        {
          "if": { "properties": { "stage": { "const": "juvenile" } } },
          "then": { "properties": { "evolution": { "properties": { "level": { "minimum": 20, "maximum": 30 } } } } }
        },
        {
          "if": { "properties": { "stage": { "const": "adolescent" } } },
          "then": { "properties": { "evolution": { "properties": { "level": { "minimum": 35, "maximum": 50 } } } } }
        }
      ]
    },
    "evolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "materials"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 100, "description": "Level gate (P2-12 replaced the old exp threshold); not consumed." },
        "materials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["element", "tier", "qty"],
            "properties": {
              "element": { "$ref": "common.schema.json#/$defs/element" },
              "tier": { "$ref": "common.schema.json#/$defs/positiveInt" },
              "qty": { "$ref": "common.schema.json#/$defs/positiveInt" }
            }
          }
        }
      }
    }
  }
}

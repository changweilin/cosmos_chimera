{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmimera.local/schemas/creature.schema.json",
  "title": "Creature file (array of creatures)",
  "description": "REQ: docs/design/creatures.md#資料模型. Cross-file refs (moves, traits, evolves_to chain) are checked by tools/validate-data.",
  "type": "array",
  "items": { "$ref": "#/$defs/creature" },
  "$defs": {
    "creature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "line_id", "stage", "size_class", "ai_style", "niches", "evolves_to", "evolution", "resist", "mastery", "stats", "signature_move", "trait", "concept"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "line_id": { "$ref": "common.schema.json#/$defs/id" },
        "stage": { "enum": ["juvenile", "adolescent", "adult", "overload"] },
        "overload_of": {
          "description": "Source adult creature id for an overload form (creatures.md#超載, Q-C12); null/absent otherwise.",
          "oneOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }]
        },
        "size_class": { "enum": ["XS", "S", "M", "L", "XL"] },
        "ai_style": {
          "description": "Combat AI positioning style. REQ: docs/design/combat.md#戰鬥 AI (Q-C21). Per stage: a line may change style as its signature move changes.",
          "enum": ["keep_distance", "flank", "charge", "hold"]
        },
        "niches": {
          "description": "Candidate ecological niches of this form with positive integer weights. REQ: docs/design/creature-ecology.md#生成順序. Non-overload forms need >= 1 and their habitat union must cover every landform (semantic check).",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["niche", "weight"],
            "properties": {
              "niche": { "$ref": "common.schema.json#/$defs/id" },
              "weight": { "$ref": "common.schema.json#/$defs/positiveInt" }
            }
          }
        },
        "evolves_to": { "oneOf": [{ "$ref": "common.schema.json#/$defs/id" }, { "type": "null" }] },
        "evolution": { "oneOf": [{ "$ref": "#/$defs/evolution" }, { "type": "null" }] },
        "resist": {
          "description": "All ten keys required: a missing key would silently read as 0 and hide authoring mistakes.",
          "type": "object",
          "required": ["metal", "wood", "water", "fire", "earth", "ice", "wind", "thunder", "light", "shadow"],
          "propertyNames": { "$ref": "common.schema.json#/$defs/element" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/resistPercent" }
        },
        "mastery": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 3,
          "propertyNames": { "$ref": "common.schema.json#/$defs/element" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/masteryPercent" }
        },
        "stats": {
          "description": "Six core stats at LV100 (creatures.md#六大能力值). The total must match the star-adjusted stage budget (creatures.md#綜合值預算), checked by tools/validate-data.",
          "type": "object",
          "additionalProperties": false,
          "required": ["hp", "speed", "yin_atk", "yang_atk", "yin_def", "yang_def"],
          "properties": {
            "hp": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
            "speed": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
            "yin_atk": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
            "yang_atk": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
            "yin_def": { "$ref": "common.schema.json#/$defs/nonNegativeInt" },
            "yang_def": { "$ref": "common.schema.json#/$defs/nonNegativeInt" }
          }
        },
        "signature_move": { "$ref": "common.schema.json#/$defs/id" },
        "trait": { "$ref": "common.schema.json#/$defs/id" },
        "field_utility": {
          "description": "Single life/field utility move or trait for this creature form (defaults to none).",
          "$ref": "common.schema.json#/$defs/fieldUtility"
        },
        "concept": {
          "description": "Open by design: shaped by creature-concept-pipeline.md, not consumed by game rules.",
          "type": "object",
          "properties": {
            "sensitivity": { "enum": ["review"] }
          }
        }
      },
      "if": { "properties": { "stage": { "enum": ["adult", "overload"] } } },
      "then": { "properties": { "evolves_to": { "type": "null" }, "evolution": { "type": "null" } } },
      "else": { "properties": { "evolves_to": { "type": "string" }, "evolution": { "type": "object" } } },
      "$comment": "REQ: docs/design/level-progression.md — level gate fixed per species, inclusive bands; mirrored by CreatureDef.EvolutionLevelMin/Max.",
      "allOf": [
        {
          "if": { "properties": { "stage": { "const": "juvenile" } } },
          "then": { "properties": { "evolution": { "properties": { "level": { "minimum": 20, "maximum": 30 } } } } }
        },
        {
          "if": { "properties": { "stage": { "const": "adolescent" } } },
          "then": { "properties": { "evolution": { "properties": { "level": { "minimum": 35, "maximum": 50 } } } } }
        },
        {
          "if": { "properties": { "stage": { "const": "overload" } } },
          "then": { "required": ["overload_of"], "properties": { "overload_of": { "type": "string" } } },
          "else": { "properties": { "overload_of": { "type": "null" } } }
        }
      ]
    },
    "evolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "materials"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 100, "description": "Level gate (P2-12 replaced the old exp threshold); not consumed." },
        "materials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["element", "tier", "qty"],
            "properties": {
              "element": { "$ref": "common.schema.json#/$defs/element" },
              "tier": { "$ref": "common.schema.json#/$defs/positiveInt" },
              "qty": { "$ref": "common.schema.json#/$defs/positiveInt" }
            }
          }
        }
      }
    }
  }
}

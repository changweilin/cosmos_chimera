{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmimera.local/schemas/food.schema.json",
  "title": "Cooked food & recipe definitions",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "cooking_method", "target", "tier", "ingredients", "heal_percent", "player_heal_percent", "duration_ms", "effects"],
    "additionalProperties": false,
    "properties": {
      "id": { "$ref": "common.schema.json#/$defs/id" },
      "cooking_method": {
        "enum": ["grill", "stew", "stir_fry", "deep_fry", "steam", "cold_mix", "grind"]
      },
      "target": {
        "enum": ["player", "active_creatures", "party", "player_and_party"]
      },
      "element": { "$ref": "common.schema.json#/$defs/element" },
      "tier": { "type": "integer", "minimum": 1, "maximum": 3 },
      "output_qty": { "type": "integer", "minimum": 1, "maximum": 10, "default": 1 },
      "ingredients": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "required": ["qty"],
          "additionalProperties": false,
          "properties": {
            "ingredient_id": { "$ref": "common.schema.json#/$defs/id" },
            "category": {
              "enum": ["meat_ground", "meat_sky", "seafood", "berry_herb", "grain_crop", "dairy", "spice_oil", "egg"]
            },
            "qty": { "type": "integer", "minimum": 1, "maximum": 20 }
          },
          "oneOf": [
            { "required": ["ingredient_id"] },
            { "required": ["category"] }
          ]
        }
      },
      "heal_percent": { "$ref": "common.schema.json#/$defs/percent" },
      "player_heal_percent": { "$ref": "common.schema.json#/$defs/percent" },
      "revive_percent": { "$ref": "common.schema.json#/$defs/percent" },
      "cleanse_negative_effects": { "type": "boolean" },
      "roll_cd_mod_percent": { "$ref": "common.schema.json#/$defs/ruleDelta" },
      "catch_rate_bonus_percent": { "$ref": "common.schema.json#/$defs/percent" },
      "drop_rate_bonus_percent": { "$ref": "common.schema.json#/$defs/percent" },
      "duration_ms": { "type": "integer", "minimum": 0, "maximum": 600000 },
      "effects": {
        "type": "array",
        "maxItems": 4,
        "items": { "$ref": "common.schema.json#/$defs/effect" }
      }
    }
  }
}
